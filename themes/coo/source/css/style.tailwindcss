@tailwind base;
@tailwind components;
@tailwind utilities;
/* =========================================
   VIBRANT MESH GRADIENT & PREMIUM GLASS
   ========================================= */

@keyframes mesh-pulse {
    0%, 100% { transform: scale(1) translate(0, 0); }
    33% { transform: scale(1.2) translate(10%, 5%); }
    66% { transform: scale(0.8) translate(-5%, 10%); }
}

.mesh-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    @apply bg-zinc-50 dark:bg-[#020617];
}

.mesh-blob {
    position: absolute;
    width: 600px;
    height: 600px;
    filter: blur(80px);
    opacity: 0.2;
    animation: mesh-pulse 20s infinite alternate cubic-bezier(0.45, 0, 0.55, 1);
    @apply dark:opacity-[0.15];
}

.blob-1 {
    background: radial-gradient(circle, rgba(99, 102, 241, 0.6) 0%, transparent 70%);
    top: -10%;
    left: -10%;
}

.blob-2 {
    background: radial-gradient(circle, rgba(168, 85, 247, 0.4) 0%, transparent 70%);
    bottom: -10%;
    right: -10%;
    animation-delay: -5s;
}

.blob-3 {
    background: radial-gradient(circle, rgba(236, 72, 153, 0.3) 0%, transparent 70%);
    top: 40%;
    left: 30%;
    animation-delay: -10s;
}

/* Glassmorphism Utilities */
.glass-panel {
    @apply bg-white/60 backdrop-blur-xl border border-white/20 shadow-glass-light;
    @apply dark:bg-zinc-900/40 dark:border-white/5 dark:shadow-glass-dark;
}

.glass-card {
    @apply bg-white/40 backdrop-blur-lg border border-white/30 rounded-2xl transition-all duration-300;
    @apply dark:bg-white/[0.03] dark:border-white/[0.05];
    @apply hover:bg-white/60 dark:hover:bg-white/[0.06] hover:scale-[1.02] hover:shadow-2xl;
}

html {
    -webkit-tap-highlight-color: transparent;
    font-family: 'Outfit', sans-serif;
    scroll-behavior: smooth;
}

body {
    @apply text-zinc-900 dark:text-zinc-100;
}

/* Updated Typography */
h1, h2, h3, .font-display {
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
}

