<!-- Premium Quick View Modal -->
<div id="quickview-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 md:p-10 pointer-events-none transition-all duration-300">
    <!-- Backdrop -->
    <div id="quickview-backdrop" class="absolute inset-0 bg-zinc-950/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-auto"></div>
    
    <!-- Modal Content -->
    <div id="quickview-content" class="relative w-full max-w-5xl h-full max-h-[90vh] glass-panel rounded-3xl shadow-3xl overflow-hidden translate-y-10 opacity-0 transition-all duration-500 scale-95 pointer-events-auto flex flex-col">
        <!-- Header -->
        <div class="flex items-center justify-between px-8 py-4 border-b border-white/5 bg-white/5">
            <div>
                <h2 id="quickview-title" class="text-xl font-bold font-display text-zinc-900 dark:text-white">Quick Preview</h2>
                <p id="quickview-subtitle" class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 uppercase tracking-wider font-medium"></p>
            </div>
            <button id="quickview-close" class="p-2 rounded-full hover:bg-white/10 transition-colors text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
                <i class="text-xl leading-none"><%- icon('close') %></i>
            </button>
        </div>
        
        <!-- Main Content (Scrollable) -->
        <div id="quickview-body" class="flex-1 overflow-y-auto p-8 custom-scrollbar bg-transparent">
            <!-- Content will be injected here -->
            <div id="quickview-loader" class="flex flex-col items-center justify-center h-full gap-4">
                <div class="w-12 h-12 border-4 border-indigo-500/20 border-t-indigo-500 rounded-full animate-spin"></div>
                <p class="text-zinc-500 dark:text-zinc-400 font-medium animate-pulse">Fetching Cheat Sheet...</p>
            </div>
            <div id="quickview-content-target" class="mdLayout hidden">
                <!-- Data injected here -->
            </div>
        </div>
        
        <!-- Footer -->
        <div class="px-8 py-4 border-t border-white/5 bg-white/5 flex items-center justify-between">
            <div class="flex items-center gap-4 text-xs text-zinc-400 uppercase tracking-widest font-bold">
                <span>Cheat Sheets v1.0</span>
            </div>
            <a id="quickview-full-link" href="#" class="inline-flex items-center px-6 py-2 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold transition-all hover:scale-105 shadow-lg shadow-indigo-500/20">
                View Full Sheet
            </a>
        </div>
    </div>
</div>
